    "import matplotlib.pyplot as plt\n",
    "from jiwer import wer\n",
    "\n",
    "def evaluate_performance(model, data_loader, vocab, device):\n",
    "    model.eval()\n",
    "    all_preds = []\n",
    "    all_refs = []\n",
    "    total_acc = 0\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for src, trg in data_loader:\n",
    "            src, trg = src.to(device), trg.to(device)\n",
    "            \n",
    "            output = model(src, trg[:, :-1])\n",
    "            predictions = torch.argmax(output, dim=-1)\n",
    "            \n",
    "            correct = (predictions == trg[:, 1:]).float()\n",
    "            mask = (trg[:, 1:] != 0).float()\n",
    "            acc = (correct * mask).sum() / mask.sum()\n",
    "            total_acc += acc.item()\n",
    "\n",
    "            for i in range(src.size(0)):\n",
    "                pred_sentence = predict(model, vocab, src[i].cpu().numpy(), device=device)\n",
    "                \n",
    "                ref_sentence = \" \".join([vocab.itos[t.item()] for t in trg[i] if t.item() not in [0, 1, 2]])\n",
    "                \n",
    "                all_preds.append(pred_sentence)\n",
    "                all_refs.append(ref_sentence)\n",
    "\n",
    "    avg_acc = total_acc / len(data_loader)\n",
    "    avg_wer = wer(all_refs, all_preds)\n",
    "    \n",
    "    return avg_acc, avg_wer"
   ]
  },
