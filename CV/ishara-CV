    "def predict(model, vocab, npy_input, max_len=20, device='cpu'):\n",
    "    model.eval()\n",
    "    \n",
    "    if isinstance(npy_input, str):\n",
    "        kp = np.load(npy_input)\n",
    "    else:\n",
    "        kp = npy_input \n",
    "        \n",
    "    src = torch.tensor(kp, dtype=torch.float32).unsqueeze(0).to(device)\n",
    "    with torch.no_grad():\n",
    "        src_emb = model.pos_encoder(model.embedding(src) * math.sqrt(model.model_dim))\n",
    "        memory = model.transformer.encoder(src_emb)\n",
    "    \n",
    "    ys = torch.ones(1, 1).fill_(vocab.stoi[\"<SOS>\"]).type(torch.long).to(device)\n",
    "    \n",
    "    generated_words = []\n",
    "    \n",
    "    for i in range(max_len):\n",
    "        with torch.no_grad():\n",
    "            trg_mask = model.generate_mask(ys.size(1)).to(device)\n",
    "            out_emb = model.pos_encoder(model.target_embedding(ys) * math.sqrt(model.model_dim))\n",
    "            \n",
    "            out = model.transformer.decoder(out_emb, memory, tgt_mask=trg_mask)\n",
    "            prob = model.fc_out(out[:, -1])\n",
    "            \n",
    "            _, next_word = torch.max(prob, dim=1)\n",
    "            next_word = next_word.item()\n",
    "            \n",
    "            if next_word == vocab.stoi[\"<EOS>\"]:\n",
    "                break\n",
    "                \n",
    "            generated_words.append(vocab.itos[next_word])\n",
    "            \n",
    "            ys = torch.cat([ys, torch.ones(1, 1).type_as(ys.data).fill_(next_word)], dim=1)\n",
    "            \n",
    "    return \" \".join(generated_words)"
   ]
