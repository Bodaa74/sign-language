    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torch.nn.utils.rnn import pad_sequence\n",
    "\n",
    "class Vocab:\n",
    "    def __init__(self, sentences):\n",
    "        self.itos = {0: \"<PAD>\", 1: \"<SOS>\", 2: \"<EOS>\", 3: \"<UNK>\"}\n",
    "        self.stoi = {v: k for k, v in self.itos.items()}\n",
    "        \n",
    "        for sentence in sentences:\n",
    "            for word in str(sentence).split():\n",
    "                if word not in self.stoi:\n",
    "                    self.stoi[word] = len(self.stoi)\n",
    "                    self.itos[len(self.itos)] = word\n",
    "    \n",
    "    def encode(self, text):\n",
    "        return [self.stoi[\"<SOS>\"]] + [self.stoi.get(w, self.stoi[\"<UNK>\"]) for w in str(text).split()] + [self.stoi[\"<EOS>\"]]\n",
    "\n",
    "class SignDataset(Dataset):\n",
    "    def __init__(self, csv_path, npy_dir, vocab):\n",
    "        self.df = pd.read_csv(csv_path)\n",
    "        self.npy_dir = npy_dir\n",
    "        self.vocab = vocab\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        kp = np.load(f\"{self.npy_dir}/{row['sample_id']}.npy\")\n",
    "        if kp is None:\n",
    "            return\n",
    "        text = self.vocab.encode(row['sentence'])\n",
    "        return torch.tensor(kp, dtype=torch.float32), torch.tensor(text, dtype=torch.long)\n",
    "\n",
    "def collate_fn(batch):\n",
    "    kps, texts = zip(*batch)\n",
    "    kps_padded = pad_sequence(kps, batch_first=True, padding_value=0.0)\n",
    "    texts_padded = pad_sequence(texts, batch_first=True, padding_value=0)\n",
    "    return kps_padded, texts_padded"
